HiddenServicePort $APP_MONERO_TOR_PORT $APP_MONERO_NODE_IP:$APP_MONERO_TOR_PORT

HiddenServiceDir /data/app-$APP_ID-rpc
HiddenServicePort $APP_MONERO_RPC_PORT $APP_MONERO_NODE_IP:$APP_MONERO_RPC_PORT
