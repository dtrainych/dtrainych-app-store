#!/usr/bin/env bash
set -euo pipefail

APP_DIR="${APP_DATA_DIR:-$(readlink -f "$(dirname "${BASH_SOURCE[0]}")/..")}"
DATA_DIR="${APP_DATA_ROOT:-${APP_DIR}/data}"

# Keep existing data in place and create missing mounts on upgrades.
mkdir -p "${DATA_DIR}/app" "${DATA_DIR}/monero" "${DATA_DIR}/i2pd"
chown 1000:1000 "${DATA_DIR}/app" "${DATA_DIR}/monero" "${DATA_DIR}/i2pd"

# The dashboard reads these identities while Tor generates them on first boot.
for kind in p2p rpc; do
    service_dir="${TOR_DATA_DIR}/app-${APP_ID}-${kind}"
    mkdir -p "${service_dir}"
    chown 1000:1000 "${service_dir}"
    chmod 700 "${service_dir}"
done

# Rebuild only the old dashboard-generated configuration from saved settings.
# Preserve a backup and leave hand-written configuration untouched.
config="${DATA_DIR}/monero/bitmonero.conf"
backup="${config}.pre-v1.1.2"
if [[ -f "${config}" && ! -e "${backup}" ]] && head -n 1 "${config}" | grep -qx '# \[chain\]'; then
    mv "${config}" "${backup}"
fi
